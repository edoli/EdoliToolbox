{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Android debug APK",
            "type": "shell",
            "command": "./gradlew",
            "windows": {
                "command": ".\\gradlew.bat"
            },
            "args": [
                ":app:assembleDebug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Edoli Toolbox without debugger",
            "type": "process",
            "command": "node",
            "args": [
                "${workspaceFolder}/.vscode/run-android.mjs"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "EDOL_ANDROID_DEVICE": "${command:PickAndroidDevice}"
                }
            },
            "dependsOn": "Build Android debug APK",
            "problemMatcher": []
        }
    ]
}
