<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/widget_preview_icon_blue"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/widget_preview_icon_green"
            android:gravity="center"
            android:text="B"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/widget_preview_icon_red"
            android:gravity="center"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/widget_preview_refresh_background"
            android:gravity="center"
            android:text="@string/recent_apps_widget_refresh"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/recent_apps_widget_title"
        android:textColor="#4B5563"
        android:textSize="12sp" />
</LinearLayout>
